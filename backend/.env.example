# =========================================================================
# RiskGuard - Predictive Maintenance Multi-Channel Notification Config
# File: backend/.env
#
# IMPORTANT:
# - All credentials remain strictly on the backend.
# - Never commit real credentials to public repositories or expose to React.
# - If credentials are missing, RiskGuard will report which channel is unconfigured.
# - If configured, notifications will actually be dispatched upon WARNING/CRITICAL alerts.
# =========================================================================

# -------------------------------------------------------------------------
# 1. EMAIL / SMTP
# -------------------------------------------------------------------------
# Compatible with Gmail (Use App Password), SendGrid, Mailgun, AWS SES, or Outlook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=RiskGuard System <riskguard-alerts@factory.com>

# -------------------------------------------------------------------------
# 2. SMS (Twilio REST API)
# -------------------------------------------------------------------------
# Obtain credentials from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------------------------------------------------------
# 3. WHATSAPP (Twilio WhatsApp)
# -------------------------------------------------------------------------
# For Twilio Sandbox: whatsapp:+14155238886 or your approved Twilio WhatsApp Sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -------------------------------------------------------------------------
# 4. DEFAULT OPERATOR DESTINATIONS
# -------------------------------------------------------------------------
# Default contact details for the on-duty maintenance engineer / plant operator
ALERT_PHONE_NUMBER=
ALERT_EMAIL=
ALERT_WHATSAPP_NUMBER=
